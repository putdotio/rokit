# Local Roku device address or hostname. Keep real device values in .env or
# .env.local. Both files are ignored.
ROKIT_TARGET=<roku-ip>

# Required for sideload install and developer screenshots.
ROKIT_PASSWORD=<developer-mode-password>

# Compatibility names used by some Roku app repos. rokit reads these as
# fallbacks when the ROKIT_* names are unset.
# ROKU_DEV_TARGET=<roku-ip>
# ROKU_DEV_PASSWORD=<developer-mode-password>

# Optional overrides.
# ROKIT_USERNAME=rokudev
# ROKIT_TIMEOUT_MS=10000

# Optional: write live probe artifacts somewhere other than .rokit/live-probe.
# ROKIT_LIVE_PROBE_DIR=.rokit/live-probe
